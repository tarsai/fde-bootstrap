# FDE config — fill in for your project
# Paths are relative to project root.

primary_design_file: design/wireframes.html
context_docs:
  - docs/handoff.md

# target_stack: describe your project's actual stack (e.g. "Expo Router + NativeWind", "Next.js 14 + Tailwind + shadcn/ui")
# This is descriptive — FDE reads it to produce correct import paths and primitives.
# Run `fde-status` after filling this in to validate it matches your package.json.
# Leave blank or omit to get an error at Phase 1 start — do not copy the example above.

# Font loading — path to the file that contains your Google Fonts @import or <link>
# Required for font-completeness validation (axes, weights, display=swap).
# font_css_path: apps/web/global.css

# Where the FDE produces artifacts
component_lib_path: src/components
tokens_path: src/styles/tokens.ts
icons_path: src/icons
copy_path: src/strings.ts

# Where dev gallery routes live
dev_gallery_route: /dev/components/
app_routes_path: src/app/

# Framework primitives — what Claude is allowed to use
runtime_primitives: div, span, button, input

# Theme mode — single | light+dark | multi-theme
theme_mode: single

# Git config
git_commit_on_approve: true
git_branch_per_phase: false  # if true, each phase runs on its own branch
